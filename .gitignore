# =====================================================================================
# CareerAI — repository-wide ignore rules.
# careerai-backend/.gitignore and frontend/.gitignore add tool-specific rules on top.
# =====================================================================================

# ---------- Dependencies and build output ----------
node_modules/
dist/
dist-ssr/
target/
build/
# Eclipse output folder (copies of sources and compiled resources)
careerai-backend/bin/

# ---------- Secrets and local configuration ----------
.env
.env.*
!.env.example
*.local
application-local.properties
application-*-local.properties
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
secrets*.*

# ---------- User data and runtime files ----------
# Uploaded resumes (personal data)
uploads/
*.log
logs/
hs_err_pid*.log
replay_pid*.log

# ---------- Local database exports ----------
*.dump
*.sql.gz
*backup*.sql
*-dump.sql
db-exports/

# ---------- Test output ----------
coverage/
test-results/
playwright-report/
.nyc_output/

# ---------- IDE / OS ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/
.DS_Store
Thumbs.db
desktop.ini
