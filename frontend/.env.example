# =====================================================================================
# CareerAI frontend — copy to .env (git-ignored) and fill in.
#
# WARNING: every VITE_* variable is compiled INTO the JavaScript bundle and is visible to
# anyone who opens the site. Only put values here that are designed to be public.
# Never put Gemini, Simli, JDoodle, Razorpay secrets, DB passwords or JWT secrets here —
# those belong to the Spring Boot backend only.
# =====================================================================================

# Backend API base URL. Optional locally (defaults to http://localhost:8080/api);
# required for a deployed build, e.g. https://your-backend.example.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Vapi voice interviews (OPTIONAL). Without these the voice interview shows "unavailable" and
# everything else works. Use the Vapi PUBLIC key (Vapi dashboard), never the private key.
# Restrict the public key to your allowed origins in the Vapi dashboard.
VITE_VAPI_PUBLIC_KEY=your-vapi-public-key
VITE_VAPI_ASSISTANT_ID=your-vapi-assistant-id
