# =====================================================================================
# CareerAI backend — environment variables (placeholders only; NEVER commit real values).
# Local: Eclipse → Run Configurations → CareerAI backend → Environment (or your shell).
# Hosting: the provider's environment-variable settings.
# Every secret stays on the server: none of these are ever sent to the React app.
#
# REQUIRED = the backend will not work correctly without it.
# OPTIONAL = the app starts without it; only that feature reports "unavailable".
# =====================================================================================

# ---------- Database (REQUIRED) ----------
# Default URL: jdbc:mysql://localhost:3306/careerai?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/careerai?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
# Locally you may instead keep it in src/main/resources/application-local.properties
# (see application-local.properties.example; that file is git-ignored).
DB_PASSWORD=your-mysql-password

# ---------- Security (REQUIRED in any deployment) ----------
# At least 32 random characters. The built-in fallback is public (it is in this repository)
# and is only for local development.
JWT_SECRET=replace-with-a-long-random-secret-of-32-plus-characters
# Optional: token lifetime in ms (default 86400000 = 24 h)
# JWT_EXPIRATION=86400000
# Comma-separated frontend origins allowed to call the API (default http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Server (OPTIONAL) ----------
# Hosting platforms that provide a port can map it with SERVER_PORT (default 8080).
# SERVER_PORT=8080
# Resume upload folder (default uploads/resumes, relative to the working directory)
# RESUME_STORAGE_DIR=uploads/resumes

# ---------- Gemini AI (OPTIONAL) ----------
# Without a key AI endpoints answer 503; ATS analysis and wording fall back to rule-based engines.
GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_TIMEOUT_SECONDS=90
# AI_MAX_REQUESTS_PER_HOUR=60

# ---------- Simli interviewer avatar (OPTIONAL) ----------
# Without a key voice interviews show the built-in interviewer instead of the avatar.
SIMLI_API_KEY=
# SIMLI_FACE_ID=

# ---------- Coding practice execution (OPTIONAL) ----------
# Provider: jdoodle (default) | judge0 | none. Without credentials code execution answers 503.
CODE_EXECUTION_PROVIDER=jdoodle
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
# JDOODLE_BASE_URL=https://api.jdoodle.com
# JDOODLE_LANGUAGE_VERSIONS=JAVA=java:5,PYTHON=python3:5,CPP=cpp17:3,JAVASCRIPT=nodejs:5

# Judge0 (optional alternative, CODE_EXECUTION_PROVIDER=judge0)
# JUDGE0_BASE_URL=
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=          (RapidAPI only)
# JUDGE0_AUTH_HEADER=X-Auth-Token
# JUDGE0_LANGUAGE_IDS=

# SQL practice needs no configuration: it runs in a disposable in-memory H2 sandbox.

# ---------- Plans and PRO payments — Razorpay (OPTIONAL, TEST MODE only) ----------
# Use TEST MODE keys (rzp_test_...). Without keys plans are shown and checkout answers
# 503 PAYMENT_GATEWAY_UNAVAILABLE. Live payments have not been tested.
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Razorpay Dashboard (Test Mode) > Account & Settings > API Keys.
# RAZORPAY_WEBHOOK_SECRET: a secret YOU choose when creating the webhook in the Razorpay Dashboard.
# Only the key id reaches the browser (in the order response).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
# PRO_MONTHLY_AMOUNT_PAISE=29900
# PRO_ANNUAL_AMOUNT_PAISE=249900
# BILLING_USAGE_ZONE=Asia/Kolkata
